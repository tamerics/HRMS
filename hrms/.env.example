# Copy this file to .env and fill in your own values

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Any long random string — used to sign login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# Port the API server listens on
PORT=4000

# ZKTeco K15 Pro attendance terminal (server-side only)
FINGERPRINT_IP=172.16.16.33
FINGERPRINT_PORT=4370
FINGERPRINT_COMM_KEY=0
FINGERPRINT_TIMEOUT=10000
FINGERPRINT_SYNC_DAYS=90
